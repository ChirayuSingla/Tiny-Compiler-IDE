// input_output.tiny - read values and compute their sum and average
var count: int;
var total: int = 0;
var value: int;
var i: int = 0;
write "How many numbers?";
read count;
while (i < count) {
    read value;
    total = total + value;
    i = i + 1;
}
write "count =", count;
write "sum   =", total;
if (count > 0) {
    write "average (integer) =", total / count;
}
